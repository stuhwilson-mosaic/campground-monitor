# Campground Monitor — environment variable reference.
# Copy this file to .env and fill in real values before running.

# ── Authentication ─────────────────────────────────────────────────────────────
# AUTH_USERNAME and AUTH_PASSWORD seed the INITIAL admin user on first boot only.
# After data/users.json exists these values are ignored. Reset/add users from /admin.
AUTH_USERNAME=stu
AUTH_PASSWORD=changeme

# ── Session ────────────────────────────────────────────────────────────────────
# Secret key used to sign session cookies — change this in production.
SESSION_SECRET=campground-monitor-secret-key-change-in-prod
# How long (in seconds) a login session stays valid. Default: 7 days.
SESSION_MAX_AGE=604800

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# SMTP server settings for email notifications.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Gmail address to send notifications from.
EMAIL_FROM=you@gmail.com
# Gmail App Password (16-char code from https://myaccount.google.com/apppasswords).
EMAIL_PASSWORD=your-app-password-here

# ── Data directories ───────────────────────────────────────────────────────────
# Where monitors.json and other runtime data are stored.
DATA_DIR=./data
# Path to the RIDB CSV export (used to populate the campground search wizard).
RIDB_DIR=./RIDBFullExport_V1_CSV

# ── Cloudflare Tunnel (OPTIONAL) ─────────────────────────────────────────────────
# Only needed for the `tunnel` service (public access on your own domain).
# Leave these unset and run `docker compose up -d app` to use localhost only.
# To expose the app: create your own tunnel, point cloudflared-camp.yml at it, then set:
# CAMP_TUNNEL_ID=your-tunnel-id
# CLOUDFLARED_CREDENTIALS=/absolute/path/to/your-tunnel-id.json
